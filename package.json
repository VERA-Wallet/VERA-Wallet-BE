{
  "name": "verawallet-be",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @vera/backend dev",
    "start": "pnpm --filter @vera/backend start",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml,prisma}\"",
    "prisma:generate": "pnpm --filter @vera/backend prisma:generate",
    "prisma:migrate": "pnpm --filter @vera/backend prisma:migrate"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
