DATABASE_URL=postgresql://vera:vera@localhost:5432/verawallet?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
MOCK_MODE=true
# 신원 검증만 따로 고른다: mock | omnione_cx | opendid. 비우면 MOCK_MODE를 따른다.
# MOCK_MODE=false로 실지갑 파이프라인을 검증하되 모바일신분증 없이 로그인하려면 mock으로 둔다.
IDENTITY_PROVIDER=
# 저장소만 따로 고른다: prisma | memory. 비우면 MOCK_MODE를 따른다(true면 인메모리, false면 Prisma).
# 공급자는 mock으로 두고 유저·거래를 Postgres에 실제로 쌓아 보려면 prisma로 둔다. prisma 외의 값은 인메모리로 떨어진다.
PERSISTENCE=
PORT=3200
FRONTEND_ORIGIN=http://localhost:3100
SIWE_TRUSTED_ORIGIN=http://localhost:3100
# OACX API 서버 = 인증창 config.mid.json의 contextPath (예: https://cx.raonsecure.co.kr:18543).
# 인증창 자산 호스트(FE의 NEXT_PUBLIC_OMNIONE_CX_AUTH_URL, 17543 포트)와 다른 서버다.
OMNIONE_CX_BASE_URL=
# OmniOne Chain RPC 인증 토큰. 콘솔(stage-chain.omnione.net)의 API Key 메뉴에서 발급한다.
# `Authorization: Bearer <값>`으로 보낸다. 이 노드는 `x-api-key`를 **받지 않는다**(401).
# OMNIONE_RPC_URL 쿼리에 `?token=`으로 붙여도 동작하지만, 실패 시 viem이 에러 메시지에 URL을
# 통째로 넣어 로그·응답에 토큰이 평문으로 남는다. 여기에 넣고 URL은 호스트만 두는 쪽을 권한다.
OMNIONE_API_KEY=
OMNIONE_RPC_URL=https://stage-chainapi.omnione.net
OMNIONE_CHAIN_ID=201210
ANCHOR_PRIVATE_KEY=
# 증거 앵커 컨트랙트(VeraAnchor) 주소. 비우면 자기 주소로 0원 전송 + calldata로 올린다(기록은 되지만 해시를 알아야 찾는다).
# 채우면 anchor(bytes32,string) 호출로 전환돼 anchors[hash] 조회와 Anchored 이벤트 목록화가 된다(해커톤 필수 요건 "컨트랙트 연동").
# 배포: cd apps/backend && npx tsx contracts/deploy.mts  (같은 ANCHOR_PRIVATE_KEY로 배포해야 콘솔에서 활동이 한 계정으로 이어진다)
# 조회: cd apps/backend && npx tsx contracts/inspect.mts [payloadHash]
# 스테이지(chainId 201210) 배포본: 0x4a36633da479A0143d09daE2aeF4E6c16dAd8673 — 콘솔 Deploy Management에서 배포(evm london, 콘솔 리소스 VeraAnchor).
# 이전 배포본 0xfcd5f59b7df2963998657373a6b0d25ba2523b72(RPC 직접 배포)은 콘솔에 안 보여 사용을 중단했다.
ANCHOR_CONTRACT_ADDRESS=
ALCHEMY_API_KEY=
# CoinGecko Demo API key (무료 가입). 과거 KRW 일봉으로 실지갑 fiat_value/price_status를 채운다.
# 비우면 과거 시세 조회를 건너뛰고 basis는 UNKNOWN 유지(MOCK_MODE=true면 어차피 미사용).
# 무료 티어 한계: 분당 ~30콜, 과거 데이터 365일. Demo는 x-cg-demo-api-key 헤더 사용.
COINGECKO_API_KEY=
# CoinGecko 플랜이 조회를 허용하는 과거 일수. Demo는 365. 유료 플랜이면 0(무제한). 창 밖의 날짜는 요청 없이 UNKNOWN으로 둔다.
COINGECKO_HISTORY_DAYS=365

# Open DID: select IDENTITY_PROVIDER=opendid above. Requires a strong JWT_SECRET.
# On the host use http://localhost:8092/verifier; Docker Desktop uses the URL below.
OPENDID_VERIFIER_URL=http://host.docker.internal:8092/verifier
OPENDID_POLICY_ID=
OPENDID_SUBJECT_CLAIM_CODE=
OPENDID_TRUSTED_ISSUER_ID=
OPENDID_HTTP_TIMEOUT_MS=10000
OPENDID_ATTEMPT_TTL_SECONDS=300
# Default response mode requires confirm-verify to return the matching issuer.
# Upstream develop omits issuer: policy mode is opt-in ONLY after verifying the
# VP policy restricts the issuer/schema and rejects an untrusted issuer's VC.
OPENDID_ISSUER_BINDING=response
OPENDID_POLICY_ISSUER_RESTRICTION_CONFIRMED=false
