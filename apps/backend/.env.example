DATABASE_URL=postgresql://vera:vera@localhost:5432/verawallet?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
MOCK_MODE=true
PORT=3200
FRONTEND_ORIGIN=http://localhost:3100
SIWE_TRUSTED_ORIGIN=http://localhost:3100
# OACX API 서버 = 인증창 config.mid.json의 contextPath (예: https://cx.raonsecure.co.kr:18543).
# 인증창 자산 호스트(FE의 NEXT_PUBLIC_OMNIONE_CX_AUTH_URL, 17543 포트)와 다른 서버다.
OMNIONE_CX_BASE_URL=
OMNIONE_API_KEY=
OMNIONE_RPC_URL=https://stage-chainapi.omnione.net
OMNIONE_CHAIN_ID=201210
ANCHOR_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=
ALCHEMY_API_KEY=
# CoinGecko Demo API key (무료 가입). 과거 KRW 일봉으로 실지갑 fiat_value/price_status를 채운다.
# 비우면 과거 시세 조회를 건너뛰고 basis는 UNKNOWN 유지(MOCK_MODE=true면 어차피 미사용).
# 무료 티어 한계: 분당 ~30콜, 과거 데이터 365일. Demo는 x-cg-demo-api-key 헤더 사용.
COINGECKO_API_KEY=
