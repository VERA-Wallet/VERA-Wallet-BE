{
  "name": "@vera/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "pnpm --filter @vera/interfaces build && pnpm --filter @vera/tax-engine build",
    "dev": "nest start --watch",
    "prestart": "pnpm --filter @vera/interfaces build && pnpm --filter @vera/tax-engine build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e.spec.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.3",
    "@vera/interfaces": "workspace:*",
    "@vera/tax-engine": "workspace:*",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "siwe": "^3.0.0",
    "viem": "^2.37.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@nestjs/cli": "^11.0.10",
    "@swc/core": "^1.13.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.16.3",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
