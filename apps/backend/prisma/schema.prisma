generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                 @id @default(uuid())
  didHash       String                 @unique
  createdAt     DateTime               @default(now())
  verifications IdentityVerification[]
  bindings      WalletBinding[]
  reports       TaxReport[]
  evidence      TaxEvidence[]
}

model IdentityVerification {
  id         String                @id @default(uuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id])
  method     String
  verifiedAt DateTime
  credential VerifiableCredential?
}

model VerifiableCredential {
  id             String               @id @default(uuid())
  verificationId String               @unique
  verification   IdentityVerification @relation(fields: [verificationId], references: [id])
  vcType         String
  status         String
  payload        Json
}

model WalletBinding {
  id             String                  @id @default(uuid())
  userId         String
  user           User                    @relation(fields: [userId], references: [id])
  walletAddress  String
  bindingHash    String?                 @unique // null for watch_only: no signature to hash
  verificationMethod String              // "siwe" | "watch_only"
  verifiedAt     DateTime?               // set when signature-verified (siwe); null for watch_only
  boundAt        DateTime                @default(now())
  initialSyncedAt DateTime?
  transactions   TransactionNormalized[]
  cursors        BindingChainCursor[]

  @@unique([userId, walletAddress])
  @@index([walletAddress])
}

model BindingChainCursor {
  id              String        @id @default(uuid())
  bindingId       String
  binding         WalletBinding @relation(fields: [bindingId], references: [id])
  chainId         Int
  lastSyncedBlock BigInt
  lastSyncedAt    DateTime      @default(now())
  // 이 체인을 마지막으로 걸었을 때의 정규화 규칙 버전(normalization-rules.ts). 상수보다 낮으면 다음 동기화가 처음부터 다시 걷는다.
  // 0 = 컬럼이 생기기 전에 걸어 둔 커서("어느 규칙인지 모름").
  rulesVersion    Int           @default(0)

  @@unique([bindingId, chainId])
  @@index([bindingId])
}

model TransactionRaw {
  id        String   @id @default(uuid())
  source    String
  payload   Json
  fetchedAt DateTime @default(now())
}

model TransactionNormalized {
  id         String        @id @default(uuid())
  bindingId  String
  binding    WalletBinding @relation(fields: [bindingId], references: [id])
  txHash     String
  eventType  String
  chain      String
  payload    Json
  occurredAt DateTime
  taxEvents  TaxEvent[]

  @@unique([bindingId, txHash, eventType])
  @@index([bindingId, occurredAt])
}

model TaxEvent {
  id          String                @id @default(uuid())
  txId        String
  tx          TransactionNormalized @relation(fields: [txId], references: [id])
  reportId    String?
  report      TaxReport?            @relation(fields: [reportId], references: [id])
  countryCode String
  ruleVersion String
  gainLoss    Decimal
  isEstimate  Boolean               @default(true)

  @@index([reportId])
  @@index([countryCode, ruleVersion])
}

model TaxReport {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  period      String
  countryCode String
  totalGain   Decimal
  status      String
  events      TaxEvent[]
  createdAt   DateTime   @default(now())
}

model HistoricalPrice {
  id        String   @id @default(uuid())
  chainId   Int
  assetKey  String // "native" for the chain's native coin, else the lowercased ERC20 contract
  date      String // UTC calendar day, YYYY-MM-DD
  krw       Decimal // daily close, KRW per one whole token
  fetchedAt DateTime @default(now())

  @@unique([chainId, assetKey, date])
}

model AnchorRecord {
  id          String   @id @default(uuid())
  payloadHash String   @unique
  anchorType  String
  chainTxHash String?
  blockNumber BigInt?
  status      String   @default("pending")
  attempts    Int      @default(0)
  anchoredAt  DateTime?
  createdAt   DateTime @default(now())

  // Privacy boundary: intentionally no User relation or userId column.
  @@index([status])
}

/// 사용자가 체인에 봉인한 계산 근거의 정본.
///
/// 체인에는 `merkleRoot`만 올라가고(AnchorRecord의 프라이버시 경계는 그대로다), 그 루트가
/// 무엇을 덮는지는 여기 남는다 — 나중에 거래 하나의 판정을 머클 증명으로 보이려면 원본이 있어야 한다.
model TaxEvidence {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  countryCode String
  taxYear     Int
  merkleRoot  String
  leafCount   Int
  document    Json
  createdAt   DateTime @default(now())

  // 같은 근거를 다시 올려도 기록은 하나다(앵커도 payloadHash 기준으로 이미 멱등이다).
  @@unique([userId, merkleRoot])
  @@index([userId, countryCode, taxYear])
}

/// Short-lived browser-bound Open DID attempts. Never stores VP/claims/JWT.
model OpenDidAttempt {
  id          String   @id
  offerId     String   @unique
  secretHash  String
  policyId    String
  country     String
  expiresAt   DateTime
  status      String   @default("pending")
  leaseToken  String?
  leaseUntil  DateTime?
  nextPollAt  DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@index([secretHash])
}
