@@ -0,0 +1,36 @@
+package org.omnione.did.verifier.v1.agent.service;
+
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.omnione.did.data.model.vc.VerifiableCredential;
+import static org.junit.jupiter.api.Assertions.*;
+
+class ConfirmationIssuerTest {
+    private VerifiableCredential credential(String issuer) {
+        VerifiableCredential vc = org.mockito.Mockito.mock(VerifiableCredential.class, org.mockito.Mockito.RETURNS_DEEP_STUBS);
+        org.mockito.Mockito.when(vc.getIssuer().getId()).thenReturn(issuer);
+        return vc;
+    }
+    @Test void usesActualCredentialIssuer() {
+        assertEquals("did:omn:other", ConfirmationIssuer.from(List.of(credential("did:omn:other"))));
+    }
+    @Test void rejectsMixedOrMultipleCredentials() {
+        assertThrows(IllegalArgumentException.class, () -> ConfirmationIssuer.from(List.of(credential("did:omn:a"), credential("did:omn:b"))));
+        assertThrows(IllegalArgumentException.class, () -> ConfirmationIssuer.from(List.of(credential("did:omn:a"), credential("did:omn:a"))));
+    }
+    @Test void rejectsMissingIssuerAndEmptyCredentialList() {
+        assertThrows(IllegalArgumentException.class, () -> ConfirmationIssuer.from(List.of(credential(""))));
+        assertThrows(IllegalArgumentException.class, () -> ConfirmationIssuer.from(List.of(new VerifiableCredential())));
+        assertThrows(IllegalArgumentException.class, () -> ConfirmationIssuer.from(List.of()));
+    }
+    @Test void bindsHolderToCredentialSubject() {
+        var vc = credential("did:omn:issuer");
+        var vp = org.mockito.Mockito.mock(org.omnione.did.data.model.vp.VerifiablePresentation.class);
+        org.mockito.Mockito.when(vp.getVerifiableCredential()).thenReturn(List.of(vc));
+        org.mockito.Mockito.when(vp.getHolder()).thenReturn("did:omn:alice");
+        org.mockito.Mockito.when(vc.getCredentialSubject().getId()).thenReturn("did:omn:alice");
+        assertEquals("did:omn:alice", ConfirmationIssuer.holder(vp));
+        org.mockito.Mockito.when(vc.getCredentialSubject().getId()).thenReturn("did:omn:bob");
+        assertThrows(IllegalArgumentException.class, () -> ConfirmationIssuer.holder(vp));
+    }
+}
