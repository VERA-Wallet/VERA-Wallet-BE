@@ -0,0 +1,27 @@
+package org.omnione.did.verifier.v1.agent.service;
+
+import java.util.List;
+import org.omnione.did.data.model.vc.VerifiableCredential;
+
+/** Issuer of the single VC in the stored, already verified VP. Never infer it from policy. */
+final class ConfirmationIssuer {
+    private ConfirmationIssuer() {}
+    static String from(List<VerifiableCredential> credentials) {
+        if (credentials == null || credentials.size() != 1 || credentials.getFirst() == null
+                || credentials.getFirst().getIssuer() == null
+                || credentials.getFirst().getIssuer().getId() == null
+                || credentials.getFirst().getIssuer().getId().isBlank()) {
+            throw new IllegalArgumentException("Confirmation requires exactly one VC with an issuer.");
+        }
+        return credentials.getFirst().getIssuer().getId();
+    }
+    static String holder(org.omnione.did.data.model.vp.VerifiablePresentation vp) {
+        from(vp.getVerifiableCredential());
+        String holder = vp.getHolder();
+        var subject = vp.getVerifiableCredential().getFirst().getCredentialSubject();
+        if (holder == null || holder.isBlank() || subject == null || !holder.equals(subject.getId())) {
+            throw new IllegalArgumentException("Verified holder must own the credential.");
+        }
+        return holder;
+    }
+}
