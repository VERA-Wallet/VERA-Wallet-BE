DATABASE_URL=postgresql://vera:vera@localhost:5432/verawallet?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
MOCK_MODE=true
PORT=3200
FRONTEND_ORIGIN=http://localhost:3100
SIWE_TRUSTED_ORIGIN=http://localhost:3100
OMNIONE_CX_BASE_URL=https://cx.raonsecure.co.kr:18543
OMNIONE_CX_AUTH_URL=https://cx.raonsecure.co.kr:17543/ent/esign
# OmniOne Chain RPC 인증 토큰. 콘솔(stage-chain.omnione.net)의 API Key 메뉴에서 발급한다.
# `Authorization: Bearer <값>`으로 보낸다. 이 노드는 `x-api-key`를 **받지 않는다**(401).
# OMNIONE_RPC_URL 쿼리에 `?token=`으로 붙여도 동작하지만, 실패 시 viem이 에러 메시지에 URL을
# 통째로 넣어 로그·응답에 토큰이 평문으로 남는다. 여기에 넣고 URL은 호스트만 두는 쪽을 권한다.
OMNIONE_API_KEY=
OMNIONE_RPC_URL=https://stage-chainapi.omnione.net
OMNIONE_CHAIN_ID=201210
ANCHOR_PRIVATE_KEY=
# 증거 앵커 컨트랙트(VeraAnchor) 주소. 비우면 자기 주소로 0원 전송 + calldata로 올린다(기록은 되지만 해시를 알아야 찾는다).
# 채우면 anchor(bytes32,string) 호출로 전환돼 anchors[hash] 조회와 Anchored 이벤트 목록화가 된다(해커톤 필수 요건 "컨트랙트 연동").
# 배포: cd apps/backend && npx tsx contracts/deploy.mts  (같은 ANCHOR_PRIVATE_KEY로 배포해야 콘솔에서 활동이 한 계정으로 이어진다)
# 조회: cd apps/backend && npx tsx contracts/inspect.mts [payloadHash]
# 스테이지(chainId 201210) 배포본: 0x4a36633da479A0143d09daE2aeF4E6c16dAd8673 — 콘솔 Deploy Management에서 배포(evm london, 콘솔 리소스 VeraAnchor).
# 이전 배포본 0xfcd5f59b7df2963998657373a6b0d25ba2523b72(RPC 직접 배포)은 콘솔에 안 보여 사용을 중단했다.
ANCHOR_CONTRACT_ADDRESS=
ALCHEMY_API_KEY=

# Report VC is opt-in and requires MOCK_MODE=false, PERSISTENCE=prisma, real CX authentication.
REPORT_VC_ENABLED=false
REPORT_VC_ISSUER_URL=
REPORT_VC_ISSUER_SERVICE_KEY=
REPORT_VC_ISSUER_DID=
REPORT_VC_LINK_POLICY_ID=
REPORT_VC_VERIFY_POLICY_ID=
# REPORT_VC uses OPENDID_VERIFIER_URL and the existing OMNIONE_CHAIN_ID/RPC/anchor settings.
